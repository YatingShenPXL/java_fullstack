<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/base.xml"/>
    <springProperty scope="context" name="appName" source="spring.application.name"/>
    <springProperty scope="context" name="lokiUrl" source="loki.url" defaultValue="http://localhost:3100"/>

    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>${lokiUrl}/loki/api/v1/push</url>
        </http>
        <labels>
            app = ${appName}
            level = %level
        </labels>
        <message>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} [${appName},%X{traceId:-},%X{spanId:-}] - %msg%n</pattern>
        </message>
        <batch>
            <maxItems>100</maxItems>
            <timeoutMs>2000</timeoutMs>
        </batch>
    </appender>

    <root level="INFO">
        <appender-ref ref="LOKI"/>
    </root>
</configuration>
